{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh launcher",
  "version": "0.1.2",
  "identifier": "com.deepseek.dsh-launcher",
  "build": {
    "beforeDevCommand": "npm run prepare:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "dsh launcher",
        "width": 780,
        "height": 500,
        "minWidth": 720,
        "minHeight": 460,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "sidecar/dsh-runtime"
    ],
    "resources": {
      "resources/nvm-v0.40.7.tar.gz": "nvm-v0.40.7.tar.gz"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
