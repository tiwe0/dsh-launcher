{
  "name": "dsh-launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "prepare:sidecar:macos-x64": "node scripts/prepare-sidecar.mjs --target x86_64-apple-darwin",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:macos-arm64": "tauri build --target aarch64-apple-darwin",
    "build:macos-x64": "tauri build --target x86_64-apple-darwin",
    "build:linux-arm64": "tauri build --target aarch64-unknown-linux-gnu --bundles deb",
    "build:linux-x64": "tauri build --target x86_64-unknown-linux-gnu --bundles deb",
    "build:windows-arm64": "tauri build --target aarch64-pc-windows-msvc --bundles nsis",
    "build:windows-x64": "tauri build --target x86_64-pc-windows-msvc",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
